# Copy to secrets.yml (gitignored) and fill in.
# Once values are working, encrypt with:
#   ansible-vault encrypt group_vars/all/secrets.yml
#
# Variable names here are canonical — main.yml references these directly,
# no `secret_*` indirection layer. Keep them in sync with main.yml.

# Proxmox API token secret UUID for the token defined in main.yml (root@pam!ansible).
# Create in Proxmox GUI: Datacenter → Permissions → API Tokens → Add,
# user root@pam, token ID "ansible", privilege separation off.
proxmox_api_token_secret: "your-proxmox-api-token-secret-uuid"

# Homepage widget token secret — separate from the Ansible password above.
# Proxmox GUI: Datacenter → API Tokens → Add, user root@pam, ID "homepage", no privilege separation.
proxmox_homepage_token_secret: "your-proxmox-homepage-token-secret"

# Portainer API token for the homepage widget.
# Portainer → Account settings → Access Tokens → Add access token.
portainer_api_key: "your-portainer-api-token"

# Root password baked into newly-created LXCs at create time.
lxc_root_password: "changeme"

# Pi-hole web admin password.
pihole_web_password: "set-something-real"

# Vaultwarden admin token.
vaultwarden_admin_token: "set-a-strong-random-token"

# Ubuntu VM root password (console + SSH fallback).
ubuntu_vm_password: "changeme"

# Nextcloud AIO admin UI passphrase.
nextcloud_aio_password: "set-a-strong-passphrase"

# Cloudflare Tunnel token for Traefik LXC.
# Zero Trust dashboard → Networks → Tunnels → your tunnel → Configure → copy token.
# Used once by `cloudflared service install`; not needed after initial run.
cloudflare_tunnel_token: "your-cloudflare-tunnel-token"

# Traefik dashboard BasicAuth users. Generate a hashed entry with:
#   htpasswd -nB admin
# Paste the full "admin:$2y$..." output as a list item below.
traefik_dashboard_users:
  - "admin:$2y$05$replacethiswithyourhtpasswdhash"
