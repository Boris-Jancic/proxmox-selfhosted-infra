{% raw %}
# Managed by Ansible (roles/monitoring). Edits here are overwritten.
groups:
  - name: meta
    rules:
      - alert: Watchdog
        expr: vector(1)
        labels:
          severity: none
        annotations:
          summary: Always firing; proves the alert pipeline works end to end.

      - alert: TargetDown
        expr: up == 0
        for: 2m
        labels:
          severity: critical
        annotations:
          summary: "{{ $labels.job }} target {{ $labels.instance }} is unreachable"

  - name: websites
    rules:
      - alert: WebsiteDown
        expr: probe_success{job="blackbox-http"} == 0
        for: 2m
        labels:
          severity: critical
        annotations:
          summary: "{{ $labels.instance }} is down"

  - name: proxmox
    rules:
      - alert: PveNodeDown
        expr: pve_up{id=~"node/.*"} == 0
        for: 2m
        labels:
          severity: critical
        annotations:
          summary: "Proxmox node {{ $labels.id }} is offline"
{% endraw %}

      - alert: PveNodeHighMemory
        expr: >-
          (pve_memory_usage_bytes{id=~"node/.*"} / pve_memory_size_bytes > {{ alert_memory_used_ratio }})
          * on(id) group_left(name) pve_node_info
        for: 10m
        labels:
          severity: warning
        annotations:
          summary: "{% raw %}Node {{ $labels.name }} memory at {{ $value | humanizePercentage }}{% endraw %}"

      - alert: PveStorageFull
        expr: >-
          pve_disk_usage_bytes{id=~"storage/.*"} / pve_disk_size_bytes > {{ alert_disk_used_ratio }}
        for: 10m
        labels:
          severity: warning
        annotations:
          summary: "{% raw %}Storage {{ $labels.id }} is {{ $value | humanizePercentage }} full{% endraw %}"

      - alert: PveGuestDiskFull
        expr: >-
          (pve_disk_usage_bytes{id=~"lxc/.*"} / pve_disk_size_bytes > {{ alert_disk_used_ratio }})
          * on(id) group_left(name) pve_guest_info
        for: 10m
        labels:
          severity: warning
        annotations:
          summary: "{% raw %}CT {{ $labels.name }} root disk is {{ $value | humanizePercentage }} full{% endraw %}"
