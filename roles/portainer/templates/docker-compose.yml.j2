services:
  portainer:
    image: {{ portainer_image }}
    container_name: portainer
    restart: unless-stopped
    ports:
      - "{{ portainer_host_port }}:9000"
      - "{{ portainer_https_port }}:9443"
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock
      - {{ portainer_data_dir }}:/data
