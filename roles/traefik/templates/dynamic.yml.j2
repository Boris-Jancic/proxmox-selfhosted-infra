http:
{% set ns_mw = namespace(has_middleware=false) %}
{% for route in traefik_routes %}
{% if route.redirect_root_to is defined or (route.basic_auth_users is defined and route.basic_auth_users | length > 0) %}
{% set ns_mw.has_middleware = true %}
{% endif %}
{% endfor %}
{% if ns_mw.has_middleware %}
  middlewares:
{% for route in traefik_routes %}
{% if route.redirect_root_to is defined %}
    {{ route.name }}-root-redirect:
      redirectRegex:
        regex: "^(https?://[^/]+)/?$"
        replacement: "${1}{{ route.redirect_root_to }}"
        permanent: true
{% endif %}
{% if route.basic_auth_users is defined and route.basic_auth_users | length > 0 %}
    {{ route.name }}-auth:
      basicAuth:
        users:
{% for user in route.basic_auth_users %}
          - "{{ user }}"
{% endfor %}
{% endif %}
{% endfor %}
{% endif %}
  routers:
{% for route in traefik_routes %}
{% set mw_list = [] %}
{% if route.redirect_root_to is defined %}{% set _ = mw_list.append(route.name + '-root-redirect') %}{% endif %}
{% if route.basic_auth_users is defined and route.basic_auth_users | length > 0 %}{% set _ = mw_list.append(route.name + '-auth') %}{% endif %}
    {{ route.name }}:
      rule: "Host(`{{ route.domain }}`)"
      service: {{ route.name }}
      entryPoints:
        - web
{% if mw_list %}
      middlewares:
{% for m in mw_list %}
        - {{ m }}
{% endfor %}
{% endif %}
{% endfor %}

  services:
{% for route in traefik_routes %}
    {{ route.name }}:
      loadBalancer:
{% if route.backend_ssl | default(false) %}
        serversTransport: insecureTransport
{% endif %}
        servers:
          - url: "{{ route.destination }}"
{% endfor %}

{% set ns = namespace(needs_insecure=false) %}
{% for route in traefik_routes %}{% if route.backend_ssl | default(false) %}{% set ns.needs_insecure = true %}{% endif %}{% endfor %}
{% if ns.needs_insecure %}
  serversTransports:
    insecureTransport:
      insecureSkipVerify: true
{% endif %}
