http:
  middlewares:
{% if traefik_security_headers_enabled %}
    security-headers:
      headers:
        stsSeconds: {{ traefik_sts_seconds }}
        stsIncludeSubdomains: true
        contentTypeNosniff: true
        referrerPolicy: "strict-origin-when-cross-origin"
{% endif %}
{% for route in traefik_routes %}
{% if route.redirect_root_to is defined %}
    {{ route.name }}-root-redirect:
      redirectRegex:
        regex: "^(https?://[^/]+)/?$"
        replacement: "${1}{{ route.redirect_root_to }}"
        permanent: true
{% endif %}
{% if route.basic_auth_users is defined and route.basic_auth_users | length > 0 %}
    {{ route.name }}-auth:
      basicAuth:
        users:
{% for user in route.basic_auth_users %}
          - "{{ user }}"
{% endfor %}
{% endif %}
{% if route.rate_limit is defined %}
    {{ route.name }}-ratelimit:
      rateLimit:
        average: {{ route.rate_limit.average | default(20) }}
        burst: {{ route.rate_limit.burst | default(50) }}
        period: {{ route.rate_limit.period | default('1m') }}
{% endif %}
{% endfor %}

  routers:
{% for route in traefik_routes %}
{% set mw_list = [] %}
{% if traefik_security_headers_enabled %}{% set _ = mw_list.append('security-headers') %}{% endif %}
{% if route.redirect_root_to is defined %}{% set _ = mw_list.append(route.name + '-root-redirect') %}{% endif %}
{% if route.basic_auth_users is defined and route.basic_auth_users | length > 0 %}{% set _ = mw_list.append(route.name + '-auth') %}{% endif %}
{% if route.rate_limit is defined %}{% set _ = mw_list.append(route.name + '-ratelimit') %}{% endif %}
    {{ route.name }}:
      rule: "Host(`{{ route.domain }}`)"
      service: {{ route.service | default(route.name) }}
      entryPoints:
        - web
{% if mw_list %}
      middlewares:
{% for m in mw_list %}
        - {{ m }}
{% endfor %}
{% endif %}
{% endfor %}

{% set ns_svc = namespace(has_services=false) %}
{% for route in traefik_routes %}{% if route.destination is defined %}{% set ns_svc.has_services = true %}{% endif %}{% endfor %}
{% if ns_svc.has_services %}
  services:
{% for route in traefik_routes %}
{% if route.destination is defined %}
    {{ route.name }}:
      loadBalancer:
{% if route.backend_ssl | default(false) %}
        serversTransport: insecureTransport
{% endif %}
        servers:
          - url: "{{ route.destination }}"
{% endif %}
{% endfor %}
{% endif %}

{% set ns = namespace(needs_insecure=false) %}
{% for route in traefik_routes %}{% if route.backend_ssl | default(false) %}{% set ns.needs_insecure = true %}{% endif %}{% endfor %}
{% if ns.needs_insecure %}
  serversTransports:
    insecureTransport:
      insecureSkipVerify: true
{% endif %}
