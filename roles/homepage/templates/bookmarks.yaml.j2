# Managed by Ansible (roles/homepage/templates/bookmarks.yaml.j2).
# LAN-only consoles that don't warrant a full service card live here.

- Admin:
    - Proxmox:
        - href: https://{{ hostvars['pve'].ansible_host }}:8006/
          icon: proxmox.png
          description: PVE node UI
    - Pi-hole admin:
        - href: http://{{ hostvars['pi-hole'].ansible_host }}/admin
          icon: pi-hole.png
          description: DNS + ad-block console
    - Nextcloud AIO:
        - href: https://{{ hostvars['ubuntu-vm1'].ansible_host }}:8080/
          icon: nextcloud.png
          description: AIO master container admin
    - Cloudflare:
        - href: https://dash.cloudflare.com/
          icon: cloudflare.png
          description: DNS zone + tunnel dashboard

- Social:
    - GitHub:
        - href: https://github.com/Boris-Jancic
          icon: github.png
          description: Profile
        - href: https://github.com/Boris-Jancic/proxmox-homelab
          icon: github.png
          description: This homelab's Ansible repo
    - YouTube:
        - href: https://www.youtube.com
          icon: youtube.png
          description: YouTube
    - Reddit:
        - href: https://www.reddit.com
          icon: reddit.png
          description: Reddit
    - WhatsApp:
        - href: https://web.whatsapp.com
          icon: whatsapp.png
          description: WhatsApp Web
