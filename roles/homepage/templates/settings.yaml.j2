# Managed by Ansible (roles/homepage/templates/settings.yaml.j2).
# Edit the template, not the rendered file on the CT.
title: jancic homelab
favicon: https://gethomepage.dev/img/favicon.svg
theme: dark
color: slate
language: en

# Mountain + milky way (Unsplash). Tuned dark + slight blur so card text
# stays readable; swap the URL to retheme without touching layout.
background:
  image: https://images.unsplash.com/photo-1419242902214-272b3f66ee7a?auto=format&fit=crop&w=2400&q=80
  blur: sm
  saturate: 50
  brightness: 50
  opacity: 100

cardBlur: sm
useEqualHeights: true

# boxedWidgets renders each header widget (resources / search / clock) in its
# own card so they line up evenly instead of floating at different heights.
headerStyle: boxedWidgets
target: _blank

# Column layout: each group renders as a vertical column, groups sit side
# by side. `columns` is not used with style: column.
# 6 columns: Infrastructure(4) · Compute(4) · Apps(4) · Today(calendar) · Admin(4) · Social(4).
# fullWidth so six columns don't get squeezed into the default max width.
maxGroupColumns: 6
fullWidth: true
layout:
  Infrastructure:
    style: column
    icon: mdi-server
  Compute:
    style: column
    icon: mdi-server-network
  Apps:
    style: column
    icon: mdi-apps
  Today:
    style: column
    icon: mdi-calendar
  Admin:
    style: column
    icon: mdi-shield-account
  Social:
    style: column
    icon: mdi-account-group
